{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golosone-tessere",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // I file statici (pannello cassa) vengono serviti direttamente dalla CDN.
  // Le rotte che non corrispondono a un file finiscono al Worker: e' cosi'
  // che /api/* e /c/:codice arrivano al codice.
  // Il binding serve al pass Apple: le immagini finiscono DENTRO il .pkpass,
  // quindi al codice non basta che la CDN le serva al browser, ne servono i
  // byte. Leggerli da qui evita una richiesta di rete verso noi stessi.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tessere",
      // In locale l'id non viene usato. Va sostituito con quello vero
      // dopo `wrangler d1 create tessere` per il deploy in produzione.
      "database_id": "f576f431-fb47-48fc-963b-ebb914f4c199"
    }
  ],

  "observability": {
    "enabled": true
  }
}
