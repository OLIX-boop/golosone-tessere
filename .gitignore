node_modules/
.wrangler/
dist/
*.log

# ---- Segreti: niente di tutto questo deve finire su GitHub ----
# Variabili locali del Worker (contengono la chiave del service account)
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Chiavi Google: il JSON del service account e qualunque chiave sciolta.
# Con quel file chiunque puo' emettere tessere a nome del negozio.
service-account*.json
*-service-account.json
*.pem
*.p12
*.key
# Richiesta di firma e certificato Apple: non sono segreti (il segreto e' la
# chiave qui sopra), ma sono roba di questa macchina e non del progetto.
*.csr
*.cer

# Chiave APNs. Questa SI' e' un segreto, e per giunta Apple la fa scaricare
# una volta sola: si carica come segreto del Worker e si tiene da parte, mai
# nel repository.
*.p8
AuthKey_*

# ---- Sessioni di Claude Code ----
# I trascritti contengono per intero i comandi eseguiti e il loro output,
# quindi anche le chiavi incollate durante il lavoro: si trasferiscono a mano
# fra i propri computer, non attraverso un repository pubblico.
*.jsonl
.claude/

# ---- Database locali ----
*.sqlite
*.sqlite3
*.db

# ---- Sistema ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# Chiavi e certificati Apple, tutti insieme: le regole qui sopra prendono
# .pem e .cer, ma non la richiesta di firma ne' l'intermedio in .der.
certificati/
